{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - NWS Challenge{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/reset-password.css') }}">
{% endblock %}

{% block body %}

<div class="reset-page">

    <div class="reset-card">

        <div class="reset-header">

            <span class="reset-label">
                NWS CHALLENGE
            </span>

            <h1>
                Mot de passe oublié ?
            </h1>

            <p>
                Entre ton adresse email et nous t'enverrons un lien
                pour réinitialiser ton mot de passe.
            </p>

        </div>

        {% for flash_error in app.flashes('reset_password_error') %}

            <div class="reset-alert" role="alert">
                {{ flash_error }}
            </div>

        {% endfor %}

        {{ form_start(requestForm, {
            'attr': {
                'class': 'reset-form'
            }
        }) }}

            {{ form_row(requestForm.email, {
                'label': 'Adresse email',
                'attr': {
                    'placeholder': 'ton@email.com'
                }
            }) }}

            <button type="submit" class="reset-button">
                Envoyer le lien
            </button>

        {{ form_end(requestForm) }}

        <a
            href="{{ path('app_login') }}"
            class="reset-back-link"
        >
            ← Retour à la connexion
        </a>

    </div>

</div>

{% endblock %}