{% extends 'base.html.twig' %}

{% block title %}Créer un compte - NWS Challenge{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/register.css') }}">
{% endblock %}

{% block body %}

<div class="register-page">

    <div class="register-container">

        <div class="register-header">

            <img
                src="{{ asset('images/NWS-logo.svg') }}"
                alt="NWS"
                class="register-logo"
            >

            <span class="register-label">
                NWS CHALLENGE
            </span>

            <h1>
                Créer un compte
            </h1>

            <p>
                Inscrivez-vous pour participer aux mini-jeux.
            </p>

        </div>


        {% for flash_error in app.flashes('verify_email_error') %}

            <div class="register-alert" role="alert">
                {{ flash_error }}
            </div>

        {% endfor %}


        {{ form_errors(registrationForm) }}


        {{ form_start(registrationForm, {
            'attr': {
                'class': 'register-form'
            }
        }) }}

            <div class="register-field">
                {{ form_row(registrationForm.email, {
                    label: 'Adresse e-mail',
                    attr: {
                        placeholder: 'ton@email.com'
                    }
                }) }}
            </div>


            <div class="register-field">
                {{ form_row(registrationForm.plainPassword, {
                    label: 'Mot de passe',
                    attr: {
                        placeholder: 'Votre mot de passe'
                    }
                }) }}
            </div>


            <div class="register-terms">

                {{ form_widget(registrationForm.agreeTerms) }}

                <label for="{{ registrationForm.agreeTerms.vars.id }}">
                    J’accepte les
                    <a
                        href="{{ path('terms') }}"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        termes et conditions
                    </a>
                </label>

            </div>

            {{ form_errors(registrationForm.agreeTerms) }}


            <button
                type="submit"
                class="register-button"
            >
                Créer mon compte
            </button>

        {{ form_end(registrationForm) }}


        <div class="register-links">

            <p>
                Déjà un compte ?
                <a href="{{ path('app_login') }}">
                    Se connecter
                </a>
            </p>

            <a href="{{ path('home') }}">
                ← Retour à l'accueil
            </a>

        </div>

    </div>

</div>

{% endblock %}